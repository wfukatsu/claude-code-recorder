{
  "name": "claude-code-recorder",
  "version": "0.2.0",
  "private": true,
  "description": "Records Claude Code exchanges (prompts, system prompt, responses, tool I/O, context) per account into a database through ScalarDB — SQLite locally, an RDBMS or NoSQL company-wide.",
  "keywords": [
    "claude-code",
    "claude",
    "hooks",
    "transcript",
    "audit",
    "usage",
    "scalardb"
  ],
  "homepage": "https://github.com/wfukatsu/claude-code-recorder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wfukatsu/claude-code-recorder.git"
  },
  "bugs": {
    "url": "https://github.com/wfukatsu/claude-code-recorder/issues"
  },
  "type": "module",
  "bin": {
    "ccrec": "bin/ccrec.js"
  },
  "files": [
    "bin",
    "src",
    "lib/ccrec-engine.jar",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "cd engine && ./gradlew -q shadowJar",
    "build:full": "cd engine && ./gradlew -q shadowJar -Pfull",
    "test": "node --test test/recorder.test.js && cd engine && ./gradlew -q test",
    "prepare": "npm run build"
  },
  "license": "UNLICENSED"
}
