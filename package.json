{
  "name": "claude-code-recorder",
  "version": "0.1.0",
  "private": true,
  "description": "Records Claude Code exchanges (prompts, system prompt, responses, tool I/O, context) per account into a database through ScalarDB — SQLite locally, an RDBMS or NoSQL company-wide.",
  "type": "module",
  "bin": {
    "ccrec": "bin/ccrec.js"
  },
  "files": [
    "bin",
    "src",
    "lib/ccrec-engine.jar",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "cd engine && ./gradlew -q shadowJar",
    "build:full": "cd engine && ./gradlew -q shadowJar -Pfull",
    "test": "node --test test/recorder.test.js && cd engine && ./gradlew -q test",
    "prepare": "npm run build"
  },
  "license": "UNLICENSED"
}
